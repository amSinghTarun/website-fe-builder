// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  projects Project[]
}

model Project {
  id                   String                @id @default(uuid())
  title                String
  initialPrompt        String?
  userId               Int
  library              String
  user                 User                  @relation(fields: [userId], references: [id])
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @default(now())
  converstationHistory ConversationHistory[]
  agentMemory          AgentMemory?
}

model ConversationHistory {
  id               Int              @id @default(autoincrement())
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id])
  contents         String
  type             ConversationType
  from             MessageFrom
  // Final response shown in the UI after completion-message rewriting.
  output           String?
  // Untouched terminal model text used to reconstruct Gemini history.
  rawOutput        String?
  errorMessage     String?
  status           ConversationRunStatus?
  toolCall         String?
  // Kept temporarily for compatibility with already-running project pods.
  completed        Boolean?
  snapshotCaptured Boolean?         @default(false)
  agentId          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  @@index([projectId, type, agentId, id])
}

model AgentMemory {
  projectId                  String   @id
  project                    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  summary                    String
  // ConversationHistory rows after this ID have not been summarized yet.
  summarizedThroughHistoryId Int
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt()
}

enum ConversationType {
  TOOL_CALL
  TEXT_MESSAGE
}

enum ConversationRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  BLOCKED
}

enum MessageFrom {
  USER
  LOOP
  ASSISTANT
}
