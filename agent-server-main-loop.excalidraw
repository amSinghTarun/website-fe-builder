      "link": null,
      "locked": false,
      "text": "SubAgentRegistry  ·  subAgents/registry.ts\n\nentries key:\n  JSON.stringify([projectId, parentRunId, id])\n\ntrack():\n  entry.completion = startLifecycle().then(result => {\n    entry.result = result;\n    onSettled?.(result);\n    return result;\n  });\n\ncollectRun(scope, \"ready\"):\n  return entries whose result already exists\n  // does not wait\n\ncollectRun(scope, \"all\"):\n  return await Promise.all(entry.completion)\n  // used only at completion boundary\n\nwaitFor(scope):\n  await one explicit sub-agent and consume it",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SubAgentRegistry  ·  subAgents/registry.ts\n\nentries key:\n  JSON.stringify([projectId, parentRunId, id])\n\ntrack():\n  entry.completion = startLifecycle().then(result => {\n    entry.result = result;\n    onSettled?.(result);\n    return result;\n  });\n\ncollectRun(scope, \"ready\"):\n  return entries whose result already exists\n  // does not wait\n\ncollectRun(scope, \"all\"):\n  return await Promise.all(entry.completion)\n  // used only at completion boundary\n\nwaitFor(scope):\n  await one explicit sub-agent and consume it",
      "autoResize": false,
      "lineHeight": 1.25
    },
