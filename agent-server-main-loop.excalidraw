      "originalText": "5. Main continuation loop  ·  providers/gemini.ts:426\n\nwhile (hasToolCall) {\n  throwIfRunCancelled(args.signal);\n  hasToolCall = false;\n  let withheldTurnText = \"\";\n\n  const session = sessions[this.sessionKey];\n\n  modelResponse = await session.chat.sendMessage({\n    message: newMessage,\n    config: createGeminiGenerationConfig({\n      systemInstruction: session.systemInstruction,\n      functionDeclarations: this.functionDeclarations(),\n      abortSignal: args.signal,\n      forceImplementationToolCall:\n        mutationRequired && !workspaceChanged\n    })\n  });\n\n  withheldTurnText = modelResponse.text ?? \"\";\n}",
