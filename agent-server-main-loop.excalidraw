      "updated": 1788084624106,
      "link": null,
      "locked": false,
      "text": "startSubAgentLifecycle()\nsubAgents/lifecycle.ts\n\nsubAgentRegistry.track(scope, async () => {\n  response = await subAgentSession.agentLoop(...);\n\n  if (response.status !== \"SUCCEEDED\")\n    return { status: \"ERROR\", ... };\n\n  mergeResult = await mergeWorktree({\n    id: response.id,\n    targetBranch: \"main\",\n    mainWorktreePath\n  });\n\n  if (mergeResult.status === \"MERGE_CONFLICT\")\n    return mergeResult;\n\n  persist LOOP / mergeWorkTree history row;\n\n  return {\n    id: response.id,\n    status: \"MERGED\",\n    summary: response.summary\n  };\n}, onSettled);\n\nFunction returns void: parent JS loop is not blocked.",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "startSubAgentLifecycle()\nsubAgents/lifecycle.ts\n\nsubAgentRegistry.track(scope, async () => {\n  response = await subAgentSession.agentLoop(...);\n\n  if (response.status !== \"SUCCEEDED\")\n    return { status: \"ERROR\", ... };\n\n  mergeResult = await mergeWorktree({\n    id: response.id,\n    targetBranch: \"main\",\n    mainWorktreePath\n  });\n\n  if (mergeResult.status === \"MERGE_CONFLICT\")\n    return mergeResult;\n\n  persist LOOP / mergeWorkTree history row;\n\n  return {\n    id: response.id,\n    status: \"MERGED\",\n    summary: response.summary\n  };\n}, onSettled);\n\nFunction returns void: parent JS loop is not blocked.",
      "autoResize": false,
      "lineHeight": 1.25
    },
