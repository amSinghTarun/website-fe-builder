      "link": null,
      "locked": false,
      "text": "7. After tool execution  ·  gemini.ts:660\n\nif (runtimeDirtyThisTurn) {\n  runtimeState = await observeRuntime(\n    handler, false, signal\n  );\n  repairMessage = runtimeRepairMessage(runtimeState);\n  if (repairMessage)\n    functionCallResponses.push({ text: repairMessage });\n}\n\nnewMessage = functionCallResponses;\n\n// Non-blocking drain of already-finished delegates:\nready = await subAgentRegistry.collectRun(\n  { projectId, parentRunId }, \"ready\"\n);\n\nif (ready.length) {\n  newMessage += delegatedResultsMessage(ready, false);\n  workspaceChanged ||= delegatedResultsChangedWorkspace(ready);\n  hasToolCall = true;\n}",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "7. After tool execution  ·  gemini.ts:660\n\nif (runtimeDirtyThisTurn) {\n  runtimeState = await observeRuntime(\n    handler, false, signal\n  );\n  repairMessage = runtimeRepairMessage(runtimeState);\n  if (repairMessage)\n    functionCallResponses.push({ text: repairMessage });\n}\n\nnewMessage = functionCallResponses;\n\n// Non-blocking drain of already-finished delegates:\nready = await subAgentRegistry.collectRun(\n  { projectId, parentRunId }, \"ready\"\n);\n\nif (ready.length) {\n  newMessage += delegatedResultsMessage(ready, false);\n  workspaceChanged ||= delegatedResultsChangedWorkspace(ready);\n  hasToolCall = true;\n}",
      "autoResize": false,
