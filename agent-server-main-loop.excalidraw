      "updated": 1788084624106,
      "link": null,
      "locked": false,
      "text": "Task-plan tools + applyTaskPlanToolCall()\ntools/task.ts · agentLoop/helpers.ts\n\ncreateTaskPlan / addTasksToPlan:\n  return yield { type: \"plan\" | \"planAppend\" }\n\napplyTaskPlanToolCall:\n  parse taskList\n  reject missing IDs/tasks\n  reject duplicate IDs\n  append valid tasks to activeTaskPlan Map\n\ninformCompletedTaskFromTaskPlan:\n  if activeTaskPlan.has(id)\n    completedTaskIds.add(id)\n\nTerminal gate:\nif activeTaskPlan.size > completedTaskIds.size {\n  newMessage = \"You still have unfinished tasks...\";\n  hasToolCall = true;\n}\n\nCompletion is model-reported; only the ID is validated.",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Task-plan tools + applyTaskPlanToolCall()\ntools/task.ts · agentLoop/helpers.ts\n\ncreateTaskPlan / addTasksToPlan:\n  return yield { type: \"plan\" | \"planAppend\" }\n\napplyTaskPlanToolCall:\n  parse taskList\n  reject missing IDs/tasks\n  reject duplicate IDs\n  append valid tasks to activeTaskPlan Map\n\ninformCompletedTaskFromTaskPlan:\n  if activeTaskPlan.has(id)\n    completedTaskIds.add(id)\n\nTerminal gate:\nif activeTaskPlan.size > completedTaskIds.size {\n  newMessage = \"You still have unfinished tasks...\";\n  hasToolCall = true;\n}\n\nCompletion is model-reported; only the ID is validated.",
      "autoResize": false,
      "lineHeight": 1.25
    },
