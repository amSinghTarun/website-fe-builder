      "link": null,
      "locked": false,
      "text": "validateFrontendBuild()\nruntime/validateFrontendBuild.ts\n\nresult = await executeInWorkspace(\n  \"npm run build\", options\n);\n\nif (result.exitCode === 0)\n  return undefined; // keep previous running state\n\nreturn {\n  status: \"unhealthy\",\n  failureScope: \"application\",\n  repairableByAgent: true,\n  reason: \"Frontend build failed ...\",\n  logs: result.output.slice(-16000),\n  fingerprint: sha256(exitCode + logs)\n};",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "validateFrontendBuild()\nruntime/validateFrontendBuild.ts\n\nresult = await executeInWorkspace(\n  \"npm run build\", options\n);\n\nif (result.exitCode === 0)\n  return undefined; // keep previous running state\n\nreturn {\n  status: \"unhealthy\",\n  failureScope: \"application\",\n  repairableByAgent: true,\n  reason: \"Frontend build failed ...\",\n  logs: result.output.slice(-16000),\n  fingerprint: sha256(exitCode + logs)\n};",
