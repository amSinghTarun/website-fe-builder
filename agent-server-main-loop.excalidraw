      "link": null,
      "locked": false,
      "text": "evaluateRuntimeRepair()\nagentLoop/helpers.ts\n\nif (!state || state.status === \"running\"\n    || !state.repairableByAgent)\n  return { action: \"none\" };\n\nfingerprint = state.fingerprint ?? \"unknown\";\nattempts[fingerprint] += 1;\n\nif (attempts <= 3) {\n  return {\n    action: \"retry\",\n    message:\n      formatRuntimeObservation(state)\n      + \" Continue working.\"\n  };\n}\n\nreturn {\n  action: \"blocked\",\n  message: \"Application remains unhealthy...\"\n};\n\nruntimeRepairMessage() sets runStatus = \"BLOCKED\"\nand emits runtimeBlocked on terminal block.",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "evaluateRuntimeRepair()\nagentLoop/helpers.ts\n\nif (!state || state.status === \"running\"\n    || !state.repairableByAgent)\n  return { action: \"none\" };\n\nfingerprint = state.fingerprint ?? \"unknown\";\nattempts[fingerprint] += 1;\n\nif (attempts <= 3) {\n  return {\n    action: \"retry\",\n    message:\n      formatRuntimeObservation(state)\n      + \" Continue working.\"\n  };\n}\n\nreturn {\n  action: \"blocked\",\n  message: \"Application remains unhealthy...\"\n};\n\nruntimeRepairMessage() sets runStatus = \"BLOCKED\"\nand emits runtimeBlocked on terminal block.",
      "autoResize": false,
      "lineHeight": 1.25
    },
