      "updated": 1788084624106,
      "link": null,
      "locked": false,
      "text": "6. Execute Gemini function calls  ·  gemini.ts:471\n\nfor (const functionCall of modelResponse.functionCalls ?? []) {\n  const tool = getTool(functionCall.name);\n  emitToolActivity(id, tool, args, \"started\", onChunk);\n\n  const toolArgs = {\n    args: { ...functionCall.args },\n    context: {\n      cwd: this.cwd,\n      databaseProjectId: this.projectId,\n      agentRunId: String(conversationRecord.id),\n      signal: args.signal\n    }\n  };\n\n  const output = await abortable(\n    Promise.resolve(\n      tool.executable(toolArgs.args, toolArgs.context)\n    ),\n    args.signal\n  );\n\n  if (output.effects?.runtimeMayChange)\n    runtimeTouched = runtimeDirtyThisTurn = true;\n  if (output.effects?.workspaceChanged)\n    workspaceChanged = true;\n\n  applyTaskPlanToolCall(...);\n  persist TOOL_CALL row;\n  handle output.yield;\n  return output.response to Gemini;\n\n  hasToolCall = true;\n}",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "6. Execute Gemini function calls  ·  gemini.ts:471\n\nfor (const functionCall of modelResponse.functionCalls ?? []) {\n  const tool = getTool(functionCall.name);\n  emitToolActivity(id, tool, args, \"started\", onChunk);\n\n  const toolArgs = {\n    args: { ...functionCall.args },\n    context: {\n      cwd: this.cwd,\n      databaseProjectId: this.projectId,\n      agentRunId: String(conversationRecord.id),\n      signal: args.signal\n    }\n  };\n\n  const output = await abortable(\n    Promise.resolve(\n      tool.executable(toolArgs.args, toolArgs.context)\n    ),\n    args.signal\n  );\n\n  if (output.effects?.runtimeMayChange)\n    runtimeTouched = runtimeDirtyThisTurn = true;\n  if (output.effects?.workspaceChanged)\n    workspaceChanged = true;\n\n  applyTaskPlanToolCall(...);\n  persist TOOL_CALL row;\n  handle output.yield;\n  return output.response to Gemini;\n\n  hasToolCall = true;\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
