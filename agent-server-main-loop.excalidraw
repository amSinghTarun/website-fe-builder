      "locked": false,
      "text": "AgentTool / ToolResult  ·  types/tools.ts\n\ninterface AgentTool<TArgs> {\n  declaration: FunctionDeclaration;\n  activity: {\n    started: string | ((args) => string);\n    completed: string | ((args) => string);\n  };\n  executable(args, context): ToolResult | Promise<ToolResult>;\n}\n\ninterface ToolResult {\n  response: unknown;       // returned to Gemini\n  yield?: ToolYield;       // emitted to UI; may pause\n  effects?: {\n    workspaceChanged?: boolean;\n    runtimeMayChange?: boolean;\n  };\n  workspacePath?: string;  // sub-agent worktree\n  branchName?: string;\n}",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AgentTool / ToolResult  ·  types/tools.ts\n\ninterface AgentTool<TArgs> {\n  declaration: FunctionDeclaration;\n  activity: {\n    started: string | ((args) => string);\n    completed: string | ((args) => string);\n  };\n  executable(args, context): ToolResult | Promise<ToolResult>;\n}\n\ninterface ToolResult {\n  response: unknown;       // returned to Gemini\n  yield?: ToolYield;       // emitted to UI; may pause\n  effects?: {\n    workspaceChanged?: boolean;\n    runtimeMayChange?: boolean;\n  };\n  workspacePath?: string;  // sub-agent worktree\n  branchName?: string;\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
